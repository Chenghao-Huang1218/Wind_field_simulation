index f87151eeaf..f5fc81aa29 100644
--- a/src/modules/ekf2/test/test_EKF_externalVision.cpp
+++ b/src/modules/ekf2/test/test_EKF_externalVision.cpp
@@ -109,6 +109,49 @@ TEST_F(EkfExternalVisionTest, checkVisionFusionLogic)
 	EXPECT_FALSE(_ekf->isGlobalHorizontalPositionValid());
 }
 
+TEST_F(EkfExternalVisionTest, nedVisionSurvivesRepeatedLandingMagCalibration)
+{
+	_sensor_simulator.runSeconds(_tilt_align_time);
+	_ekf_wrapper.enableExternalVisionPositionFusion();
+	_ekf_wrapper.enableExternalVisionHeadingFusion();
+	_sensor_simulator._vio.setPositionFrameToLocalNED();
+	_sensor_simulator.startExternalVision();
+	_sensor_simulator.runSeconds(3);
+	ASSERT_TRUE(_ekf->control_status_flags().yaw_align);
+	ASSERT_TRUE(_ekf_wrapper.isIntendingExternalVisionPositionFusion());
+	ASSERT_TRUE(_ekf_wrapper.isIntendingExternalVisionHeadingFusion());
+
+	for (int flight = 0; flight < 3; ++flight) {
+		SCOPED_TRACE(flight);
+		_ekf->set_vehicle_at_rest(false);
+		_ekf->set_in_air_status(true);
+		_sensor_simulator.runSeconds(2);
+		_ekf->set_in_air_status(false);
+		_ekf->set_vehicle_at_rest(true);
+
+		// EKF2 marks the next mag sample reset when landing/disarming applies
+		// learned calibration. Inject that event through the public sensor API.
+		_sensor_simulator._mag.stop();
+		_sensor_simulator.runMicroseconds(20000);
+		_ekf->setMagData(magSample{_sensor_simulator.getTime(), Vector3f(0.2f, 0.f, 0.4f), true});
+		_sensor_simulator.runMicroseconds(200000);
+		_sensor_simulator._mag.start();
+		_sensor_simulator.runSeconds(8); // Exceed the horizontal aiding timeout.
+
+		EXPECT_TRUE(_ekf->control_status_flags().yaw_align);
+		EXPECT_TRUE(_ekf_wrapper.isIntendingExternalVisionHeadingFusion());
+		EXPECT_TRUE(_ekf_wrapper.isIntendingExternalVisionPositionFusion());
+		EXPECT_TRUE(_ekf->isLocalHorizontalPositionValid());
+	}
+
+	// Preserving alignment must not keep position valid when EV actually stops.
+	_sensor_simulator.stopExternalVision();
+	_sensor_simulator.runSeconds(12);
+	EXPECT_FALSE(_ekf_wrapper.isIntendingExternalVisionHeadingFusion());
+	EXPECT_FALSE(_ekf_wrapper.isIntendingExternalVisionPositionFusion());
+	EXPECT_FALSE(_ekf->isLocalHorizontalPositionValid());
+}
